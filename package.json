{
  "name": "versatiles-documentation",
  "version": "1.0.0",
  "description": "Documentation for VersaTiles",
  "homepage": "https://github.com/versatiles-org/versatiles-documentation#readme",
  "bugs": {
    "url": "https://github.com/versatiles-org/versatiles-documentation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versatiles-org/versatiles-documentation.git"
  },
  "scripts": {
    "build": "vitepress build .",
    "sync:spec": "tsx scripts/sync-spec.ts",
    "check": "npm run format && npm run lint && npm run lint:types && npm run sync:spec -- --check && npm run build",
    "dev": "vitepress dev .",
    "format": "prettier --log-level warn --write .",
    "format:check": "prettier --log-level warn --check .",
    "lint": "eslint .",
    "lint:types": "vue-tsc --noEmit",
    "preview": "vitepress preview .",
    "upgrade": "npm-check-updates -u --peer && npm i"
  },
  "license": "Unlicense",
  "type": "commonjs",
  "overrides": {
    "vite": ">=7.3.2 <8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "github-slugger": "^2.0.0",
    "globals": "^17.13.0",
    "markdown-it-task-lists": "^2.1.1",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitepress": "^1.6.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
