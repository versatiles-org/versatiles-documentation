{
  "name": "versatiles-documentation",
  "version": "1.0.0",
  "description": "Documentation for VersaTiles",
  "homepage": "https://github.com/versatiles-org/versatiles-documentation#readme",
  "bugs": {
    "url": "https://github.com/versatiles-org/versatiles-documentation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versatiles-org/versatiles-documentation.git"
  },
  "scripts": {
    "build": "npm run validate:showcases && npm run build:showcase-images && npm run build:social-image && npm run build:vitepress",
    "build:vitepress": "vitepress build .",
    "build:showcase-images": "tsx scripts/build-showcase-images.ts",
    "build:social-image": "tsx scripts/build-social-image.ts",
    "sync:deps": "tsx scripts/build-dependency-graph.ts",
    "deps:drift": "tsx scripts/build-dependency-graph.ts --drift",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "sync:spec": "tsx scripts/sync-spec.ts",
    "check": "npm run format && npm run lint && npm run lint:types && npm run test && npm run sync:spec -- --check && npm run sync:deps -- --check && npm run build",
    "dev": "vitepress dev .",
    "format": "prettier --log-level warn --write .",
    "format:check": "prettier --log-level warn --check .",
    "lint": "eslint .",
    "lint:types": "vue-tsc --noEmit",
    "preview": "vitepress preview .",
    "upgrade": "npm-check-updates -u --peer && npm i",
    "validate:showcases": "tsx scripts/validate-showcases.ts"
  },
  "license": "Unlicense",
  "type": "commonjs",
  "overrides": {
    "vite": ">=7.3.2 <8"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.3",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "elkjs": "^0.12.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "github-slugger": "^2.0.0",
    "globals": "^17.13.0",
    "js-yaml": "^5.4.2",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.0.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
